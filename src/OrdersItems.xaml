<Window x:Class="Shop.OrdersItems"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Shop"
        mc:Ignorable="d"
        Title="Чудо-обувь. Состав заказа" Height="450" Width="800"
        Icon="Resources/Чудо Обувь.png">
    <Grid>
        <Image Source="/Resources/Чудо Обувь.png" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,11,0,0"/>
        <Label Content="Состав заказа" FontSize="20" FontWeight="Bold" Foreground="#70B2AF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="75,10,0,0"/>
        <Label x:Name="information"  FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Top"  Margin="0,56,0,0" Height="36" Width="758"/>
        <Label Content="Дата заказа:" VerticalAlignment="Top" FontFamily="Calibri" Margin="242,18,457,0"/>
        <DatePicker x:Name="datePicker" Margin="465,20,182,386"/>
        <Label x:Name="dateLabel" VerticalAlignment="Top" FontFamily="Calibri" FontSize="14" 
       Margin="354,22,350,0" Background="#D2F6E7" BorderBrush="#FF70B2AF" BorderThickness="1" Height="24"/>

        <DataGrid x:Name="sostav" Margin="20,110,20,60" Background="#D2F6E7" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" FontSize="14">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding Size}"  Width="80"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N0}}" Width="100"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Sum, StringFormat={}{0:N0}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
        <Label x:Name="itog" FontSize="18" FontWeight="Bold" Foreground="#70B2AF" HorizontalAlignment="Right" VerticalAlignment="Bottom"  Margin="0,0,20,20" Height="16" Width="222"/>
        <Button Content="Назад" Width="120" Height="30" Background="#D2F6E7" Foreground="#70B2AF" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,20" Click="Button_Click"/>
        <Button x:Name="delete" Content="Удалить позицию" Width="150" Height="30" Background="#D2F6E7" Foreground="#70B2AF" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="160,0,0,20" Click="DeleteItem_Click"/>
        <Button x:Name="saveDate" Content="Сохранить"  Background="#D2F6E7" Foreground="#70B2AF" HorizontalAlignment="Left" Margin="628,21,0,0" VerticalAlignment="Top" Width="92" Height="24" Click="Button_Click_1"/>
        <Button x:Name="add" Content="Добавить позицию" Background="#D2F6E7" Foreground="#70B2AF" HorizontalAlignment="Left" Margin="322,386,0,0" VerticalAlignment="Top" Height="28" Width="142" FontWeight="Bold" Click="Button_Click_2"/>
    </Grid>
</Window>