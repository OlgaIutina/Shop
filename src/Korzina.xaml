<Window x:Class="Shop.Korzina"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо-обувь. Корзина" Height="450" Width="800"
        Icon="Resources/Чудо Обувь.png" WindowStartupLocation="CenterScreen" Background="White">
    <Grid>
        <Image Source="/Resources/Чудо Обувь.png" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,15,0,0"/>
        <Label Content="Ваша корзина" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="70,20,0,0" FontSize="22" FontWeight="Bold" Foreground="#FF70B2AF" FontFamily="Calibri"/>
        <Button Content="Назад" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,20,0" Background="#D2F6E7" Foreground="#FF70B2AF" FontWeight="Bold" FontFamily="Calibri" Width="100" Height="30" Click="Back_Click"/>
        <DataGrid x:Name="cartGrid" Margin="20,75,20,80" AutoGenerateColumns="False"
          CanUserAddRows="False" Background="#D2F6E7" BorderBrush="#FF70B2AF"
          FontFamily="Calibri" FontSize="14">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding Product.Name}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding SizeValue}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Product.DiscountedPrice, StringFormat={}{0:N0}}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalSum, StringFormat={}{0:N0}}" Width="100" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
        <Label x:Name="total" Content="Итого: 0 ₽" FontSize="20" FontWeight="Bold" Foreground="#FF70B2AF" FontFamily="Calibri" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,20"/>
        <Button Content="Оформить заказ" Background="#D2F6E7" Foreground="#FF70B2AF" FontWeight="Bold" FontFamily="Calibri" Width="180" Height="35" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20" Click="Checkout_Click"/>
        <Button Content="Очистить" Background="#D2F6E7" Foreground="#FF70B2AF" FontWeight="Bold" FontFamily="Calibri" Width="150" Height="35" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,210,20" Click="Clear_Click"/>
    </Grid>
</Window>