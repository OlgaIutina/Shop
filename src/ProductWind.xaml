<Window x:Class="Shop.ProductWind"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо-обувь. Товар" Height="590" Width="800"
        Icon="/Resources/Чудо Обувь.png" WindowStartupLocation="CenterScreen" Background="White">
    <Grid>
        <Image Source="/Resources/Чудо Обувь.png" Width="59" Height="58" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,10,0,0"/>
        <Label Content="Информация о товаре" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="105,18,0,0" FontSize="22" FontWeight="Bold" Foreground="#FF70B2AF" FontFamily="Calibri"/>
        <Image x:Name="photo" HorizontalAlignment="Left" VerticalAlignment="Top" Width="270" Height="262" Margin="40,149,0,0" Stretch="Uniform"/>

        <Label Content="Название:" HorizontalAlignment="Left" Margin="330,80,0,0" VerticalAlignment="Top" FontFamily="Calibri"/>
        <TextBox IsReadOnly="True" x:Name="nam" HorizontalAlignment="Left" Margin="480,83,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="254" Background="#D2F6E7" BorderBrush="#FF70B2AF" Height="33"/>

        <Label Content="Производство:" HorizontalAlignment="Left" Margin="330,124,0,0" VerticalAlignment="Top" FontFamily="Calibri"/>
        <TextBox IsReadOnly="True" x:Name="proizvod" HorizontalAlignment="Left" Margin="480,127,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="254" Background="#D2F6E7" BorderBrush="#FF70B2AF" Height="31"/>

        <Label Content="Категория:" HorizontalAlignment="Left" Margin="330,168,0,0" VerticalAlignment="Top" FontFamily="Calibri"/>
        <TextBox IsReadOnly="True" x:Name="categor" HorizontalAlignment="Left" Margin="480,171,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="254" Background="#D2F6E7" BorderBrush="#FF70B2AF"/>

        <Label Content="Цена со скидкой:" HorizontalAlignment="Left" Margin="330,203,0,0" VerticalAlignment="Top" FontFamily="Calibri"/>
        <TextBox IsReadOnly="True" x:Name="skidka" HorizontalAlignment="Left" Margin="480,206,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="254" Background="#D2F6E7" BorderBrush="#FF70B2AF"/>

        <Label Content="Состав:" HorizontalAlignment="Left" Margin="330,235,0,0" VerticalAlignment="Top" FontFamily="Calibri"/>
        <TextBox IsReadOnly="True" x:Name="sostav" HorizontalAlignment="Left" Margin="480,238,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="254" Background="#D2F6E7" BorderBrush="#FF70B2AF" Height="43"/>

        <Label Content="Описание:" HorizontalAlignment="Left" Margin="330,291,0,0" VerticalAlignment="Top" FontFamily="Calibri"/>
        <TextBox IsReadOnly="True" x:Name="opisanie" HorizontalAlignment="Left" Margin="480,294,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="254" Height="55" Background="#D2F6E7" BorderBrush="#FF70B2AF"/>

        <Label Content="Размерный ряд:" HorizontalAlignment="Left" Margin="330,360,0,0" VerticalAlignment="Top" FontFamily="Calibri"/>
        <TextBox IsReadOnly="True" x:Name="sizeRange" HorizontalAlignment="Left" Margin="480,363,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="254" Background="#D2F6E7" BorderBrush="#FF70B2AF"/>

        <Label Content="Размеры (в наличии):" HorizontalAlignment="Left" Margin="330,388,0,0" VerticalAlignment="Top" FontFamily="Calibri" FontWeight="Bold"/>
        <ComboBox x:Name="size" HorizontalAlignment="Left" Margin="480,391,0,0" Width="254" VerticalAlignment="Top" Background="#D2F6E7" BorderBrush="#FF70B2AF"/>

        <Label Content="Количество:" HorizontalAlignment="Left" Margin="330,423,0,0" VerticalAlignment="Top" FontFamily="Calibri" FontWeight="Bold"/>
        <TextBox x:Name="qty" HorizontalAlignment="Left" Margin="480,426,0,0" Width="60" VerticalAlignment="Top" Text="1" Background="#D2F6E7" BorderBrush="#FF70B2AF"/>

        <Button Content="В корзину" Background="#D2F6E7" Foreground="#FF70B2AF" FontWeight="Bold" FontFamily="Calibri" HorizontalAlignment="Left" Margin="480,477,0,0" VerticalAlignment="Top" Width="150" Height="30" Click="AddToCart_Click"/>
        <Button Content="Закрыть" Background="#D2F6E7" Foreground="#FF70B2AF" FontWeight="Bold" FontFamily="Calibri" HorizontalAlignment="Left" Margin="640,477,0,0" VerticalAlignment="Top" Width="90" Height="30" Click="Back_Click"/>
    </Grid>
</Window>